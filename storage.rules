rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /purchase-orders/{poId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf)|image/(jpeg|png|webp|heic|heif)');
    }
  }
}
