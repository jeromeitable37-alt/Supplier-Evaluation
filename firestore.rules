rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && profile().role == 'admin' && profile().active == true;
    }
    function hasPermission(permission) {
      return hasProfile() && profile().active == true && (isAdmin() || permission in profile().permissions);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.active == true;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'displayName', 'department', 'jobTitle', 'phone', 'bio', 'photoURL', 'updatedAt', 'email'
          ]));
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if hasPermission('view_dashboard');
      allow create: if hasPermission('create_evaluations') || hasPermission('import_excel')
        || (
          request.resource.data.publicToken is string
          && request.resource.data.evaluatorRole == 'requisitioner'
          && request.resource.data.poNumber == get(/databases/$(database)/documents/evaluationLinks/$(request.resource.data.publicToken)).data.po.poNumber
          && get(/databases/$(database)/documents/evaluationLinks/$(request.resource.data.publicToken)).data.status == 'pending'
        );
      allow update: if hasPermission('edit_evaluations') || hasPermission('import_excel');
      allow delete: if hasPermission('delete_evaluations');
    }

    match /purchaseOrders/{purchaseOrderId} {
      allow read: if hasPermission('view_dashboard') || hasPermission('create_evaluations');
      allow create, update: if hasPermission('create_evaluations') || hasPermission('edit_evaluations');
      allow delete: if hasPermission('delete_evaluations');
    }

    match /evaluationLinks/{token} {
      allow get: if resource.data.token == token;
      allow list: if hasPermission('view_dashboard');
      allow create: if hasPermission('create_evaluations')
        && request.resource.data.token == token
        && request.resource.data.status == 'pending';
      allow update: if (
        resource.data.token == token
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'submittedAt', 'evaluationId'])
        && request.resource.data.status == 'submitted'
      ) || hasPermission('edit_evaluations');
      allow delete: if hasPermission('delete_evaluations');
    }

    match /workspace/{documentId} {
      allow read: if signedIn();
      allow write: if documentId == 'seed' && signedIn() || hasPermission('system_settings');
    }
  }
}
